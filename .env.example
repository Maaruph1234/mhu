# ---- Supabase ----
# Project Settings > API in your Supabase dashboard
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# ---- App ----
VITE_APP_NAME=MHU Global
# Used to build shareable links (e.g. referral links) so they always point
# at the real site, even when testing from a local dev server.
VITE_APP_URL=https://mhuglobal.com
VITE_APP_STORE_URL=#
VITE_PLAY_STORE_URL=#

# =====================================================================
# The sections below (Smsala + VTpass + Provibill) are NOT read by the
# frontend. They belong in your Supabase Edge Function secrets, never in
# client code or a .env file that ships to the browser, because they are
# private API keys. Set them with:
#
#   supabase secrets set SMSALA_API_TOKEN=xxx SMSALA_SENDER_ID=xxx
#   supabase secrets set VTPASS_API_KEY=xxx VTPASS_SECRET_KEY=xxx VTPASS_PUBLIC_KEY=xxx VTPASS_BASE_URL=https://sandbox.vtpass.com/api
#
# They're listed here only so you know exactly what to gather.
# ---------------------------------------------------------------------
# SMSALA_API_TOKEN=            # from smsala.com dashboard > API
# SMSALA_SENDER_ID=            # approved sender ID/name
# VTPASS_API_KEY=              # from sandbox.vtpass.com (or vtpass.com for live) > Profile > API Keys
# VTPASS_SECRET_KEY=           # same page, generated alongside the public key -- shown once
# VTPASS_PUBLIC_KEY=           # same page, generated alongside the secret key -- shown once
# VTPASS_BASE_URL=             # https://sandbox.vtpass.com/api for testing,
#                                # https://vtpass.com/api once provisioned for live
#
# Provibill (NOT currently used -- see README "Provibill" section for why;
# its bank-provided sandbox server was never reachable). Left here only in
# case that gets resolved later.
# PROVIBILL_BASE_URL=          # e.g. http://154.113.16.142:9999/provipay/webapi
# PROVIBILL_USERNAME=          # Basic Auth username from Provibill
# PROVIBILL_PASSWORD=          # Basic Auth password from Provibill
# PROVIBILL_ACCOUNT_NO=        # merchant/settlement account number
# PROVIBILL_PROXY_URL=         # static-IP proxy, needed for bank IP whitelisting
#
# Payvessel — ACTIVE for USD virtual card issuing, eSIM, flight booking, and
# extra-document identity verification (license/voter's card/passport) only.
# Wallet funding and bank payouts switched to Xpress Wallet (see that
# section below); BVN/NIN verification at signup is still Korapay. Shared
# by ALL payvessel-* edge functions in supabase/functions/ --
# see README.md's "Payvessel" section for what each one does and which extra
# secrets/deploys it needs on top of these three:
#
#   supabase secrets set PAYVESSEL_API_KEY=xxx PAYVESSEL_SECRET=xxx PAYVESSEL_BASE_URL=https://sandbox.payvessel.com
#
# PAYVESSEL_API_KEY=            # PVTESTKEY-xxx (sandbox) or live equivalent, from your Payvessel
#                                # dashboard's API Keys page.
# PAYVESSEL_SECRET=             # PVTESTSECRET-xxx (sandbox) or live equivalent, same page. Also
#                                # used to verify the webhook's HMAC-SHA512 signature.
# PAYVESSEL_BASE_URL=           # https://sandbox.payvessel.com for testing,
#                                # https://api.payvessel.com once you move to live keys.
# PAYVESSEL_BUSINESS_ID=        # from your Payvessel dashboard, separate from the key/secret --
#                                # required by payvessel-create-account (virtual account creation).
# PAYVESSEL_USD_NGN_RATE=       # manually maintained NGN-per-USD rate, NOT a live FX feed -- used
#                                # by payvessel-cards (card funding/withdrawal) and as a fallback in
#                                # payvessel-flight (if a quote's currency isn't already NGN). Update
#                                # periodically; see README.md for why there's no live rate lookup.
# IDENTITY_VERIFICATION_FEE_NGN=# flat NGN fee charged per extra ID check (NIN/license/voter's
#                                # card/passport) in payvessel-identity -- covers Payvessel's own
#                                # per-lookup cost, which applies even when a document isn't found.
#
# Korapay — ACTIVE for BVN/NIN verification at signup only (korapay-verify-bvn,
# korapay-verify-nin). NO LONGER used for wallet funding or bank payouts --
# those switched to Xpress Wallet below (Sept 2026, same month, two
# switches). korapay-create-account/korapay-payout/korapay-webhook are left
# deployed but unused; nothing calls them client-side any more.
#
#   supabase secrets set KORAPAY_SECRET_KEY=xxx KORAPAY_BASE_URL=https://api.korapay.com KORAPAY_BANK_CODE=xxx
#
# KORAPAY_SECRET_KEY=           # sk_test_xxx (sandbox) or sk_live_xxx, from Settings > API
#                                # Configuration on your Kora dashboard. Used both to call the
#                                # API and to verify the x-korapay-signature webhook header
#                                # (HMAC-SHA256 of the "data" object -- confirmed against
#                                # developers.korapay.com/docs/webhooks).
# KORAPAY_PUBLIC_KEY=           # pk_test_xxx / pk_live_xxx -- not currently used server-side,
#                                # kept here in case a client-side Korapay Checkout is added later.
# KORAPAY_ENCRYPTION_KEY=       # from the same dashboard page -- not used by the virtual account
#                                # flow implemented here, only needed if you add card payments
#                                # via Korapay's encrypted-card-details API later.
# KORAPAY_BASE_URL=             # https://api.korapay.com for both test and live -- Korapay
#                                # doesn't use a separate sandbox subdomain, the sk_test_/sk_live_
#                                # prefix on your secret key determines the mode.
# KORAPAY_BANK_CODE=            # "000" is REQUIRED to create virtual accounts while using test
#                                # keys (see developers.korapay.com/docs/virtual-bank-accounts-ngn).
#                                # Switch to a real bank_code (e.g. "035" Wema, "070" Fidelity --
#                                # korapay-create-account defaults to "070" if this isn't set)
#                                # once you move to live keys.
#
# Xpress Wallet (Providus Bank) — the ACTIVE provider for wallet funding and
# bank payouts ("Transfer to bank"), switched back from Korapay Sept 2026.
# Endpoints/fields confirmed against developer.providusbank.com's live docs,
# not guessed. Unlike Korapay/Payvessel before it, the account this creates
# per user is a REAL Providus Bank account with its own live balance, not a
# pass-through virtual account -- see src/lib/xpressWallet.ts. Shared by
# ALL xpresswallet-* functions in supabase/functions/ (xpresswallet-create-
# wallet, xpresswallet-transfer, xpresswallet-webhook, plus
# _shared/xpresswallet-auth.ts):
#
#   supabase secrets set XPRESSWALLET_EMAIL=xxx XPRESSWALLET_PASSWORD=xxx XPRESSWALLET_PRIVATE_KEY=xxx
#
# XPRESSWALLET_BASE_URL=        # defaults to https://api.xpresswallet.com if unset -- Xpress
#                                # Wallet's docs don't show a separate sandbox subdomain; ask
#                                # Providus/your dashboard whether sandbox mode uses this same URL
#                                # or a different one before going live.
# XPRESSWALLET_EMAIL=           # your Xpress Wallet merchant dashboard login email
# XPRESSWALLET_PASSWORD=        # your Xpress Wallet merchant dashboard login password -- used to
#                                # log in via POST /auth/login on every function call (Xpress
#                                # Wallet uses short-lived access/refresh tokens, not a single
#                                # static secret key like every other provider here)
# XPRESSWALLET_PRIVATE_KEY=     # sk_sandbox_xxx / sk_live_xxx from the dashboard's Access Keys
#                                # page (GET /merchant/my-access-keys) -- only needed for bank
#                                # transfers and merchant wallet lookups, sent as a Bearer token
#                                # on top of the access/refresh tokens above
# XPRESSWALLET_WEBHOOK_SECRET=  # invent your own random string; append as ?secret=... on the
#                                # callbackURL you register via PATCH /merchant/profile, and the
#                                # xpresswallet-webhook function checks it on every call. NOTE:
#                                # Xpress Wallet's real webhook payload shape isn't publicly
#                                # documented -- xpresswallet-webhook logs every raw delivery to
#                                # the xpresswallet_webhook_events table so the real shape can be
#                                # confirmed from an actual test transfer rather than guessed at.
